{
  "titles": [
    {"start": 0,     "end": 28.42, "no": "TRAINING 02", "jp": "ドラゴンフラッグ", "en": "DRAGON FLAG"},
    {"start": 28.42, "end": null,  "no": "TRAINING 02", "jp": "腹筋",             "en": "SIT-UP"}
  ],
  "telops": [
    {"start": 0.05,  "end": 2.99,  "text": "次は[お腹]のトレーニングになります"},
    {"start": 2.99,  "end": 6.40,  "text": "こういった台とかを利用してもらって"},
    {"start": 6.73,  "end": 9.13,  "text": "[ドラゴンフラッグ]っていうやつをやっていきましょう"},
    {"start": 9.13,  "end": 11.45, "text": "手すりがない人は"},
    {"start": 11.45, "end": 13.17, "text": "後の動画を見てもらえたらと思うんですけど"},
    {"start": 13.17, "end": 15.31, "text": "こんな感じで手すりにつかまって"},
    {"start": 15.31, "end": 18.03, "text": "伸ばしてから[ゆっくり下げる]"},
    {"start": 18.03, "end": 19.57, "text": "というのを意識してやってみてください"},
    {"start": 19.57, "end": 22.60, "text": "かなり[お腹に効く]いいトレーニングなので"},
    {"start": 23.07, "end": 27.30, "text": "このベンチがあれば ぜひ積極的に取り入れてみてください"},
    {"start": 27.99, "end": 31.11, "text": "ない場合は 足もかけなくていいので"},
    {"start": 31.11, "end": 34.60, "text": "普通に[よくある腹筋]をしてもらえたらと思います"},
    {"start": 34.81, "end": 38.41, "text": "でも結構固くて痛い場合も多いので"},
    {"start": 38.41, "end": 40.91, "text": "その場合は[タオル]とかも持参してみましょう"}
  ]
}
