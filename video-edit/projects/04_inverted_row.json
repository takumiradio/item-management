{
  "titles": [
    {"start": 0, "end": null, "no": "TRAINING 04", "jp": "インバーテッドロウ", "en": "INVERTED ROW"}
  ],
  "telops": [
    {"start": 0.00,  "end": 2.46,  "text": "それでは [肩と背中]を鍛える"},
    {"start": 2.46,  "end": 4.00,  "text": "[インバーテッドロウ]という"},
    {"start": 4.00,  "end": 5.92,  "text": "トレーニングについて解説していきます"},
    {"start": 5.92,  "end": 8.08,  "text": "こんな感じで[鉄棒]に"},
    {"start": 8.08,  "end": 10.38, "text": "ぶら下がってやってみましょう"},
    {"start": 10.38, "end": 12.92, "text": "角度とかはご自身で"},
    {"start": 12.92, "end": 15.48, "text": "ぶら下がってみたら いい[角度]が見つかると思うので"},
    {"start": 15.48, "end": 16.76, "text": "やってみてもらって"},
    {"start": 16.76, "end": 20.60, "text": "つま先を立てて 膝は[ピーン]と伸ばして"},
    {"start": 20.88, "end": 23.64, "text": "[みぞおち]を近づけるようにやってみてください"},
    {"start": 23.64, "end": 26.32, "text": "肩関節が前に行ったり"},
    {"start": 26.32, "end": 28.22, "text": "後ろに[行きすぎない]ように"},
    {"start": 28.22, "end": 31.72, "text": "その場にあるようにしてトレーニングしてみてください"},
    {"start": 31.72, "end": 33.54, "text": "手の幅はこれぐらい"},
    {"start": 33.54, "end": 35.58, "text": "[肩幅より広い]ぐらいの"},
    {"start": 35.58, "end": 38.90, "text": "自然な幅でやってみてください"}
  ]
}
