{
  "titles": [
    {"start": 0, "end": null, "no": "TRAINING 03", "jp": "段差昇降", "en": "STEP-UP"}
  ],
  "telops": [
    {"start": 0.00,  "end": 2.86,  "text": "それでは こういった段差を使った"},
    {"start": 2.86,  "end": 4.88,  "text": "[足]のトレーニングの解説をしていきます"},
    {"start": 4.88,  "end": 7.36,  "text": "階段とかがない人もいると思うので"},
    {"start": 7.36,  "end": 10.22, "text": "こんな感じで ちょっとした[段差]がどこかにあると思うので"},
    {"start": 10.22, "end": 13.64, "text": "こうやって[登ったり降りたり]しながら"},
    {"start": 13.64, "end": 17.80, "text": "足のトレーニング [下半身]のトレーニングをしていきましょう"},
    {"start": 18.06, "end": 20.32, "text": "こうやって交互に 交互に"},
    {"start": 20.32, "end": 22.62, "text": "[片足ずつ]登っていくことで"},
    {"start": 22.62, "end": 24.76, "text": "[バランスよく]効率的に"},
    {"start": 24.76, "end": 26.36, "text": "引き締める効果がありますので"},
    {"start": 26.36, "end": 30.54, "text": "本当に[思い立ったとき]にやっていきましょう"},
    {"start": 30.54, "end": 33.60, "text": "こうやって[ジャンプ]とかもしてもらっても"},
    {"start": 33.60, "end": 35.04, "text": "かなりいいトレーニングになります"},
    {"start": 35.04, "end": 37.04, "text": "大人になると 意識しないと"},
    {"start": 37.04, "end": 38.62, "text": "ジャンプってあまりしないと思うんですけど"},
    {"start": 38.62, "end": 40.18, "text": "どんどん[衰えて]いっちゃうので"},
    {"start": 40.18, "end": 41.68, "text": "こういった段差とかを利用して"},
    {"start": 41.68, "end": 44.38, "text": "[できる範囲で]やっていきましょう"}
  ]
}
