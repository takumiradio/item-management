{
  "titles": [
    {
      "no": "TRAINING 01",
      "jp": "腕立て伏せ",
      "en": "PUSH-UP",
      "start": 0,
      "end": null
    }
  ],
  "telops": [
    {
      "start": 0.2,
      "end": 3.28,
      "text": "それでは 腕立て伏せの解説をしていきます"
    },
    {
      "start": 3.28,
      "end": 8.02,
      "text": "やはり 上半身を総合的に鍛えるのが一番"
    },
    {
      "start": 8.02,
      "end": 10.68,
      "text": "腕立て伏せが もう結論[最強]なので"
    },
    {
      "start": 10.68,
      "end": 13.72,
      "text": "ぜひ少しずつでもやっていきましょう"
    },
    {
      "start": 13.72,
      "end": 15.04,
      "text": "こんな感じですね"
    },
    {
      "start": 15.04,
      "end": 17.9,
      "text": "手幅は肩幅より[ちょっと広い]ぐらいで"
    },
    {
      "start": 17.9,
      "end": 20.72,
      "text": "体が曲がらないように"
    },
    {
      "start": 20.72,
      "end": 22.4,
      "text": "腰が上がったりしないように"
    },
    {
      "start": 22.4,
      "end": 25.96,
      "text": "ピーンと[一直線]になるようにしてやってみてください"
    },
    {
      "start": 25.96,
      "end": 28.7,
      "text": "最初はすごく難しいと思うんですけど"
    },
    {
      "start": 28.7,
      "end": 30.3,
      "text": "[ゆっくり]やっていきましょう"
    },
    {
      "start": 30.86,
      "end": 33.06,
      "text": "前から見るとこんな感じ"
    },
    {
      "start": 33.06,
      "end": 34.3,
      "text": "これぐらいの手幅なので"
    },
    {
      "start": 34.3,
      "end": 36.62,
      "text": "ぜひ参考にしてもらって"
    },
    {
      "start": 36.62,
      "end": 39.66,
      "text": "[自然な形]の手幅で大丈夫です"
    },
    {
      "start": 39.66,
      "end": 43.6,
      "text": "手幅を少しこんな感じで[狭める]と"
    },
    {
      "start": 43.6,
      "end": 45.1,
      "text": "[二の腕]に効きますので"
    },
    {
      "start": 45.1,
      "end": 47.04,
      "text": "二の腕を引き締めたい人は"
    },
    {
      "start": 47.04,
      "end": 49.0,
      "text": "こっちもやっていきましょう"
    }
  ]
}