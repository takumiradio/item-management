  "telops": [
    {"start": 0.00,  "end": 3.42,  "text": "それでは [懸垂]についての説明をしていきます"},
    {"start": 3.42,  "end": 5.80,  "text": "まず 手の[握り方]について"},
    {"start": 5.80,  "end": 9.24,  "text": "しっかり こんな感じで[握り込む]ようにしてみましょう"},
    {"start": 9.24,  "end": 10.82, "text": "しっかり握ってください"},
    {"start": 11.06, "end": 14.54, "text": "そのまま持ち上がっていきます"},
    {"start": 14.54, "end": 17.46, "text": "ぐーっと持ち上がっていくんですけど"},
    {"start": 17.46, "end": 20.32, "text": "かなり難しいと思うので"},
    {"start": 20.32, "end": 23.62, "text": "最初は [ぶら下がるだけ]でも十分な効果があるので"},
    {"start": 23.62, "end": 25.60, "text": "[ゆっくり]気長にやっていきましょう"},
    {"start": 26.42, "end": 28.92, "text": "こうやって[胸を近づける]ように"},
    {"start": 28.92, "end": 30.76, "text": "意識してやってみてください"},
    {"start": 30.76, "end": 32.48, "text": "胸を近づけた結果"},
    {"start": 32.48, "end": 35.50, "text": "体が上がっている そういったイメージです"}
  ]
