{
  "titles": [
    {"start": 0, "end": null, "no": "TRAINING 08", "jp": "リバース\nプッシュアップ", "en": "REVERSE PUSH-UP", "size": 60}
  ],
  "telops": [
    {"start": 0.30,  "end": 4.00,  "text": "では [リバースプッシュアップ]の解説をしていきます"},
    {"start": 4.00,  "end": 7.28,  "text": "二の腕とかに すごい[引き締め]の効果のある"},
    {"start": 7.28,  "end": 8.98,  "text": "いいトレーニングになるので"},
    {"start": 8.98,  "end": 11.54, "text": "女性とか特に試してもらって"},
    {"start": 11.54, "end": 13.40, "text": "ぜひ取り入れていきましょう"},
    {"start": 13.40, "end": 16.40, "text": "こんな感じで膝を[ピーン]と立てて"},
    {"start": 16.40, "end": 19.48, "text": "こうやってトレーニングしていくんですけども"},
    {"start": 19.48, "end": 21.28, "text": "前から見るとこんな感じ"},
    {"start": 21.28, "end": 26.40, "text": "[肩幅よりちょっと広い]ぐらいに置いてもらって"},
    {"start": 26.40, "end": 28.26, "text": "ゆっくりこのように"},
    {"start": 28.26, "end": 32.08, "text": "[収縮・伸展]させていきましょう"},
    {"start": 32.08, "end": 34.10, "text": "この[二の腕]に負荷が乗っているように"},
    {"start": 34.10, "end": 36.36, "text": "意識してみてください"},
    {"start": 36.36, "end": 38.86, "text": "[ゆっくり]で構いませんから"},
    {"start": 38.86, "end": 40.88, "text": "あまり早くやりすぎちゃうと"},
    {"start": 40.88, "end": 41.86, "text": "負荷が抜けるので"},
    {"start": 41.86, "end": 43.78, "text": "ゆっくり ゆっくり"},
    {"start": 43.78, "end": 47.93, "text": "曲げて伸ばしてを[繰り返して]みてください"}
  ]
}
