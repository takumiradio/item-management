{
  "titles": [
    {"start": 0, "end": null, "no": "TRAINING 05", "jp": "斜め腕立て伏せ", "en": "INCLINE PUSH-UP"}
  ],
  "telops": [
    {"start": 0.00,  "end": 4.00,  "text": "それでは [斜め]の状態での腕立て伏せの解説をしていきます"},
    {"start": 4.26,  "end": 7.48,  "text": "最初の平行状態での腕立て伏せが"},
    {"start": 7.48,  "end": 8.78,  "text": "きついという人は"},
    {"start": 8.78,  "end": 10.50, "text": "こっちからやるのが[おすすめ]です"},
    {"start": 10.50, "end": 12.72, "text": "ある程度[負担が軽減]されるので"},
    {"start": 12.72, "end": 13.84, "text": "こっちからやっていきましょう"},
    {"start": 13.84, "end": 15.58, "text": "こんな感じですね"},
    {"start": 15.58, "end": 17.82, "text": "なるべく体を[まっすぐ]にして"},
    {"start": 17.82, "end": 20.96, "text": "トレーニングしてみてください"},
    {"start": 20.96, "end": 24.72, "text": "肘も[90度]ぐらいまで曲げて"},
    {"start": 24.72, "end": 27.46, "text": "しっかり[テンポよく]やっていきましょう"},
    {"start": 27.46, "end": 29.34, "text": "[膝]も曲げないようにしてみてくださいね"},
    {"start": 29.34, "end": 33.04, "text": "手の幅はこれぐらいですね"},
    {"start": 33.04, "end": 36.36, "text": "[肩より広め]でやっていきましょう"},
    {"start": 36.36, "end": 40.01, "text": "やりやすい幅でやってもらったら大丈夫です"}
  ]
}
