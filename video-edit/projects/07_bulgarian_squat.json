{
  "titles": [
    {"start": 0, "end": null, "no": "TRAINING 07", "jp": "ブルガリアン\nスクワット", "en": "BULGARIAN SQUAT"}
  ],
  "telops": [
    {"start": 0.14,  "end": 4.40,  "text": "それでは [ブルガリアンスクワット]の解説をしていきます"},
    {"start": 5.32,  "end": 7.28,  "text": "足の引き締めにめちゃくちゃ"},
    {"start": 7.28,  "end": 9.94,  "text": "[効果的]なトレーニングなので"},
    {"start": 9.94,  "end": 11.80, "text": "ぜひ取り入れていきましょう"},
    {"start": 12.00, "end": 15.32, "text": "こんな感じで[片足]をちょっと高台に乗せて"},
    {"start": 15.32, "end": 16.68, "text": "トレーニングしていきます"},
    {"start": 16.68, "end": 17.88, "text": "ポイントとしては"},
    {"start": 17.88, "end": 22.50, "text": "引っ掛けている方の足は[力を抜いて]"},
    {"start": 22.50, "end": 28.92, "text": "この曲げている方の足は"},
    {"start": 28.92, "end": 31.70, "text": "[かかと重心]でやっていきましょう"},
    {"start": 31.70, "end": 34.30, "text": "つま先ではなくて かかと重心で"},
    {"start": 34.30, "end": 36.54, "text": "引っ掛けている方の足は"},
    {"start": 36.54, "end": 39.16, "text": "[力を抜く]っていう感じになります"},
    {"start": 39.16, "end": 43.20, "text": "そのように意識してトレーニングしてみてください"},
    {"start": 44.24, "end": 46.74, "text": "手の位置は 自然な位置でいいです"},
    {"start": 46.74, "end": 48.44, "text": "上げてもいいですし 下げてもいいので"},
    {"start": 48.44, "end": 49.64, "text": "やってみてください"},
    {"start": 49.64, "end": 51.72, "text": "しっかり下げる"},
    {"start": 51.72, "end": 53.02, "text": "しっかり[お尻を下げる 上げる]を"},
    {"start": 53.02, "end": 56.12, "text": "意識してやってみてください"}
  ]
}
